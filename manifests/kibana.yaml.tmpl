apiVersion: kibana.k8s.elastic.co/v1
kind: Kibana
metadata:
  name: __NAME__
  namespace: __NAMESPACE__
spec:
  version: "9.5.5"
  image: __KIBANA_IMAGE__
  count: 1
  elasticsearchRef:
    name: __NAME__
  http:
    service:
      spec:
        type: ClusterIP
  podTemplate:
    spec:
      containers:
        - name: kibana
          resources:
            requests:
              cpu: 250m
              memory: 1Gi
            limits:
              cpu: "1"
              memory: 2Gi
